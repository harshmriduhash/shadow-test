generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL") // uses connection pooling
  directUrl = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
}

model User {
  id               String         @id // Use Clerk ID directly
  email            String?        @unique
  stripeCustomerId String?        @unique
  createdAt        DateTime       @default(now())
  
  projects      Project[]
  subscriptions Subscription[]
  reportShares  ReportShare[]
  memberships   Membership[]
}

model Organization {
  id              String   @id
  name            String
  isPersonal      Boolean  @default(false) @map("is_personal")
  stripeCustomerId String? @unique @map("stripe_customer_id")
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  memberships   Membership[]
  projects      Project[]
  usageRecords  UsageRecord[]
  subscription  Subscription?

  @@index([deletedAt])
}

model Membership {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  role           String   @default("org:member")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model UsageRecord {
  id              String   @id @default(cuid())
  organizationId  String   @map("organization_id")
  periodStart     DateTime @db.Date @map("period_start")
  simulationsUsed Int      @default(0) @map("simulations_used")
  costUsd         Decimal  @default(0) @db.Decimal(12, 6) @map("cost_usd")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, periodStart])
  @@index([organizationId, periodStart])
}

model Project {
  id          String   @id @default(cuid())
  userId      String
  organizationId String @map("organization_id")
  name        String
  description String?
  repoUrl     String?  @map("repo_url")
  productUrl  String?  @map("product_url")
  createdAt   DateTime @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  personas    Persona[]
  simulations Simulation[]
  documents   ProjectDocument[]

  @@index([userId, createdAt])
  @@index([organizationId, createdAt])
}

model ProjectDocument {
  id            String   @id @default(cuid())
  projectId     String
  fileName      String   @map("file_name")
  contentType   String   @map("content_type")
  sizeBytes     Int      @map("size_bytes")
  storageKey    String   @unique @map("storage_key")
  status        String   @default("UPLOADING")
  error         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([projectId, status])
}

model Persona {
  id                 String   @id @default(cuid())
  projectId          String
  name               String
  traits             String
  behaviorModel      String   @map("behavior_model")
  technicalKnowledge Int      @default(3) @map("technical_knowledge")
  patience           Int      @default(3)
  decisionSpeed      Int      @default(3) @map("decision_speed")
  riskTolerance      Int      @default(3) @map("risk_tolerance")
  attentionToDetail  Int      @default(3) @map("attention_to_detail")
  createdAt          DateTime @default(now())

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  simulations Simulation[]

  @@index([projectId])
}

model Simulation {
  id        String   @id @default(cuid())
  projectId String
  personaId String
  task      String
  idempotencyKey String? @map("idempotency_key")
  status    String   @default("PENDING") // PENDING, RUNNING, COMPLETED, FAILED
  success   Boolean?
  createdAt DateTime @default(now())

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  persona   Persona   @relation(fields: [personaId], references: [id], onDelete: Cascade)
  steps     SimulationStep[]
  reports   Report[]
  events    SimulationEvent[]

  @@index([projectId, createdAt])
  @@index([personaId])
  @@unique([projectId, idempotencyKey])
}

model SimulationEvent {
  id           String   @id @default(cuid())
  simulationId String
  stepNumber   Int      @map("step_number")
  type         String
  severity     String   @default("MEDIUM")
  description  String
  evidence     String?
  createdAt    DateTime @default(now())

  simulation Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  @@index([simulationId, type])
  @@index([simulationId, stepNumber])
}

model SimulationStep {
  id             String   @id @default(cuid())
  simulationId   String
  stepNumber     Int      @map("step_number")
  observation    String?
  interpretation String?
  decision       String?
  action         String?
  outcome        String?
  createdAt      DateTime @default(now())

  simulation Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  @@index([simulationId, stepNumber])
}

model Report {
  id           String   @id @default(cuid())
  simulationId String
  summary      String?
  insights     String?  // Can store JSON string
  createdAt    DateTime @default(now())

  simulation Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  shares     ReportShare[]

  @@index([simulationId])
}

model ReportShare {
  id              String    @id @default(cuid())
  reportId        String
  createdByUserId String    @map("created_by_user_id")
  tokenHash       String    @unique @map("token_hash")
  expiresAt       DateTime  @map("expires_at")
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  report    Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  createdBy User   @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([reportId, createdAt])
  @@index([expiresAt, revokedAt])
}

model Subscription {
  id                   String   @id @default(cuid())
  userId               String?
  organizationId       String   @unique @map("organization_id")
  stripeSubscriptionId String?  @unique
  plan                 String   @default("FREE")
  status               String   @default("FREE")
  currentPeriodEnd     DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
}

model BillingEvent {
  id        String   @id @default(cuid())
  eventId   String   @unique
  type      String
  createdAt DateTime @default(now())
}
