generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL") // uses connection pooling
  directUrl = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
}

model User {
  id               String         @id // Use Clerk ID directly
  email            String?        @unique
  stripeCustomerId String?        @unique
  createdAt        DateTime       @default(now())
  
  projects      Project[]
  subscription Subscription?
}

model Project {
  id          String   @id @default(cuid())
  userId      String
  organizationId String? @map("organization_id")
  name        String
  description String?
  repoUrl     String?  @map("repo_url")
  productUrl  String?  @map("product_url")
  createdAt   DateTime @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  personas    Persona[]
  simulations Simulation[]
  documents   ProjectDocument[]

  @@index([userId, createdAt])
  @@index([organizationId, createdAt])
}

model ProjectDocument {
  id            String   @id @default(cuid())
  projectId     String
  fileName      String   @map("file_name")
  contentType   String   @map("content_type")
  sizeBytes     Int      @map("size_bytes")
  storageKey    String   @unique @map("storage_key")
  status        String   @default("UPLOADING")
  error         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([projectId, status])
}

model Persona {
  id            String   @id @default(cuid())
  projectId     String
  name          String
  traits        String   // Can store JSON string
  behaviorModel String   @map("behavior_model")
  createdAt     DateTime @default(now())

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  simulations Simulation[]

  @@index([projectId])
}

model Simulation {
  id        String   @id @default(cuid())
  projectId String
  personaId String
  task      String
  status    String   @default("PENDING") // PENDING, RUNNING, COMPLETED, FAILED
  success   Boolean?
  createdAt DateTime @default(now())

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  persona   Persona   @relation(fields: [personaId], references: [id], onDelete: Cascade)
  steps     SimulationStep[]
  reports   Report[]

  @@index([projectId, createdAt])
  @@index([personaId])
}

model SimulationStep {
  id             String   @id @default(cuid())
  simulationId   String
  stepNumber     Int      @map("step_number")
  observation    String?
  interpretation String?
  decision       String?
  action         String?
  outcome        String?
  createdAt      DateTime @default(now())

  simulation Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  @@index([simulationId, stepNumber])
}

model Report {
  id           String   @id @default(cuid())
  simulationId String
  summary      String?
  insights     String?  // Can store JSON string
  createdAt    DateTime @default(now())

  simulation Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  @@index([simulationId])
}

model Subscription {
  id                   String   @id @default(cuid())
  userId               String   @unique
  stripeSubscriptionId String?  @unique
  plan                 String   @default("FREE")
  status               String   @default("FREE")
  currentPeriodEnd     DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BillingEvent {
  id        String   @id @default(cuid())
  eventId   String   @unique
  type      String
  createdAt DateTime @default(now())
}
