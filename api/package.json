{
  "name": "shadowtest-api",
  "version": "1.0.0",
  "description": "ShadowTest API Backend",
  "main": "dist/index.js",
  "scripts": {
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "migrate:deploy": "prisma migrate deploy",
    "test": "npm run build && node --test test/*.test.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/s3-presigned-post": "^3.1164.0",
    "@aws-sdk/s3-request-presigner": "^3.1164.0",
    "@prisma/client": "^5.22.0",
    "bullmq": "^5.81.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jose": "^5.9.6",
    "redis": "^5.12.2",
    "stripe": "^17.5.0",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.2",
    "prisma": "^5.22.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "qs": "^6.17.1"
  }
}
